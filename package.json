{
  "name": "figma-email-agent",
  "version": "1.0.0",
  "type": "module",
  "description": "Figma plugin to convert email designs to HTML using Gemini AI",
  "scripts": {
    "proxy": "node proxy-server.cjs",
    "dev": "vite build --watch",
    "build": "npm run build:main && npm run build:ui && npm run build:fix",
    "build:main": "vite build",
    "build:ui": "BUILD_TARGET=ui vite build",
    "build:fix": "mv dist/src/ui.html dist/ui.html && rmdir dist/src 2>/dev/null || true && sed -i '' 's/type=\"module\" crossorigin/defer/g' dist/ui.html"
  },
  "dependencies": {
    "@google/genai": "^2.10.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "url-polyfill": "^1.1.14",
    "web-streams-polyfill": "^4.3.0",
    "zod": "^4.4.3",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@babel/plugin-transform-spread": "^7.29.7",
    "@figma/plugin-typings": "^1.130.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.2",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.19",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vite-plugin-static-copy": "^4.1.1"
  }
}
